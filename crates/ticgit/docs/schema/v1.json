{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ticgit.dev/schema/v1.json",
  "title": "TicGit machine output schema v1",
  "description": "Stable JSON shapes emitted by TicGit v1 machine-readable commands. `ti show --json` and JSON mutation commands emit a ticket object. `ti list --json` emits an array of ticket objects. `ti next --json` emits a ticket object, or the sentinel `{ \"next\": null }` when no workable ticket matches. Ticket objects from `ti next` and `ti show` additionally carry an optional `subissues` array (recursive open-only sub-issue tree). Every ticket object carries `deleted`: `{ at, by }` for a deleted ticket, `null` otherwise. `ti sync --json` emits a sync result object and `ti pull <url> --json` a pull result object; the `warnings` array of each reports edits that landed on a ticket deleted locally. `ti reindex --json` emits a reindex result object.",
  "oneOf": [
    {
      "$ref": "#/$defs/ticket"
    },
    {
      "$ref": "#/$defs/ticketList"
    },
    {
      "$ref": "#/$defs/nextNull"
    },
    {
      "$ref": "#/$defs/syncResult"
    },
    {
      "$ref": "#/$defs/pullResult"
    },
    {
      "$ref": "#/$defs/reindexResult"
    }
  ],
  "$defs": {
    "nextNull": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next"],
      "properties": {
        "next": {
          "type": "null",
          "description": "Emitted by `ti next --json` when no workable ticket matches."
        }
      }
    },
    "ticketList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ticket"
      }
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "spec",
        "status",
        "state",
        "assigned",
        "closed_by",
        "priority",
        "points",
        "milestone",
        "code",
        "parent",
        "children",
        "depends_on",
        "blocks",
        "tags",
        "meta",
        "comments",
        "created_at",
        "created_by"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "spec": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "new",
            "assigned",
            "in-progress",
            "blocked",
            "review",
            "resolved",
            "wontfix",
            "duplicate",
            "invalid"
          ]
        },
        "assigned": {
          "type": [
            "string",
            "null"
          ]
        },
        "closed_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "User email that last closed the ticket."
        },
        "priority": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Ticket priority. Lower values = more important (1 is highest)."
        },
        "points": {
          "type": [
            "integer",
            "null"
          ]
        },
        "milestone": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "description": "Git URI in the format https://<host>/<path>:<branch>"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "subissues": {
          "type": "array",
          "description": "Recursive open-only sub-issue tree. Additive, optional field emitted by `ti next` and `ti show`; absent from `ti list` and mutation output. Not a stored field.",
          "items": {
            "$ref": "#/$defs/subissueNode"
          }
        },
        "deleted": {
          "description": "The ticket's Deletion: who deleted it and when, or `null` for a live ticket. Emitted on every ticket object; additive and optional so output from ti <= 0.4.2 (which has no Deletion) still validates. Deleted tickets are hidden from `ti list` unless `--deleted` is passed; `ti undelete` restores them.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/deletion"
            }
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true,
          "description": "Tickets this ticket depends on (must be resolved before this can proceed)"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true,
          "description": "Tickets that depend on this ticket (denormalized reverse of depends_on)"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "meta": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        }
      }
    },
    "deletion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "by"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "When the winning delete operation was written."
        },
        "by": {
          "type": "string",
          "description": "Author email of the winning delete operation."
        }
      }
    },
    "subissueNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state", "subissues"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "subissues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subissueNode"
          }
        }
      }
    },
    "syncResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "Emitted by `ti sync --json`.",
      "required": [
        "remote",
        "ref",
        "url",
        "web_url",
        "pulled",
        "updated",
        "pushed_total",
        "push_retries"
      ],
      "properties": {
        "remote": {
          "type": ["string", "null"],
          "description": "Git remote synced with, or null when none is configured."
        },
        "ref": {
          "type": "string",
          "description": "Meta ref synced, e.g. `refs/meta/main`."
        },
        "url": {
          "type": "string"
        },
        "web_url": {
          "type": ["string", "null"]
        },
        "pulled": {
          "type": "array",
          "description": "Tickets that appeared during the pull.",
          "items": {
            "$ref": "#/$defs/syncTicketRef"
          }
        },
        "updated": {
          "type": "array",
          "description": "Tickets already known locally that the pull changed.",
          "items": {
            "$ref": "#/$defs/syncTicketRef"
          }
        },
        "pushed_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Ticket count after the sync."
        },
        "push_retries": {
          "type": "integer",
          "minimum": 0,
          "description": "How many times the push merged a remote that advanced after the pull and retried."
        },
        "warnings": {
          "type": "array",
          "description": "Things the sync merged that the user should know about. Always emitted by current binaries (empty when there is nothing to report); absent from older ones. Each entry is also printed to stderr as one `warning:` line. Exit status is unaffected.",
          "items": {
            "$ref": "#/$defs/syncWarning"
          }
        }
      }
    },
    "syncTicketRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "syncWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ticket",
        "count"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["edit-on-deleted"],
          "description": "`edit-on-deleted`: operations that follow the ticket's delete operation in Lamport order, or comments, set members or custom fields, arrived for a ticket that was deleted locally before the merge and still is. They are kept on the hidden ticket; `ti undelete <ticket>` shows them. Later versions may add kinds; ignore kinds you do not know."
        },
        "ticket": {
          "type": "string",
          "format": "uuid",
          "description": "Full id of the ticket the warning is about."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "How many items arrived."
        }
      }
    },
    "pullResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "Emitted by `ti pull <url> --json` (a fork pull).",
      "required": [
        "source",
        "imported",
        "updated",
        "imported_tickets",
        "updated_tickets"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "URL pulled from (a saved nickname is resolved to its URL)."
        },
        "imported": {
          "type": "integer",
          "minimum": 0,
          "description": "How many tickets were new to this clone."
        },
        "updated": {
          "type": "integer",
          "minimum": 0,
          "description": "How many known tickets the fork changed."
        },
        "imported_tickets": {
          "type": "array",
          "description": "The fork's state of each imported ticket. A ticket deleted on the fork imports deleted.",
          "items": {
            "$ref": "#/$defs/ticket"
          }
        },
        "updated_tickets": {
          "type": "array",
          "description": "The fork's state of each updated ticket.",
          "items": {
            "$ref": "#/$defs/ticket"
          }
        },
        "warnings": {
          "type": "array",
          "description": "As in a sync result. Always emitted by current binaries (empty when there is nothing to report); absent from older ones.",
          "items": {
            "$ref": "#/$defs/syncWarning"
          }
        }
      }
    },
    "reindexResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "Emitted by `ti reindex --json`.",
      "required": [
        "tickets"
      ],
      "properties": {
        "tickets": {
          "type": "integer",
          "minimum": 0,
          "description": "Ticket count after the reindex, deleted tickets included."
        },
        "fetched": {
          "type": "boolean",
          "description": "Whether the meta remote was fetched first. False when no meta remote is configured or it could not be reached; the reindex then reads the refs the last sync fetched. Always emitted by current binaries."
        },
        "reset": {
          "type": "boolean",
          "description": "Whether this was the guarded wholesale `--reset` rather than the additive reindex. Always emitted by current binaries."
        }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "at",
        "body"
      ],
      "properties": {
        "author": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "body": {
          "type": "string"
        }
      }
    }
  }
}
